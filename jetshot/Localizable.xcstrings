            "value": "MUSIC"
          }
        }
      }
    },
    "settings.off": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "VYP"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OFF"
          }
        }
      }
    },
    "settings.on": {
